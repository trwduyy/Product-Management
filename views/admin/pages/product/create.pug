extends ../../layouts/default.pug

block main
  h1(class="mb-4") #{formTitle}

  form(
    action=formAction
    id="form-create-product"
    method="POST"
    enctype="multipart/form-data"
  )
    if isEdit
      input(type="hidden" name="_method" value="PATCH")
    div(class="form-group")
      label(for="title") Title
      input(
        type="text"
        class="form-control"
        id="title"
        name="title"
        value=formData.title
        required
      )
    div(class="form-group")
      label(for="desc") Description
      textarea(
        class="form-control"
        id="desc"
        name="description"
        rows="5"
      ) #{formData.description}
    div(class="form-group")
      label(for="price") Price
      input(
        type="number"
        class="form-control"
        id="price"
        name="price"
        value=formData.price || 0
        min="0"
      )
    div(class="form-group")
      label(for="discount") % Discount
      input(
        type="number"
        class="form-control"
        id="discount"
        name="discountPercentage"
        value=formData.discountPercentage || 0
        min="0"
      )
    div(class="form-group")
      label(for="stock") Stock
      input(
        type="number"
        class="form-control"
        id="stock"
        name="stock"
        value=formData.stock || 0
        min="0"
      )
    div(class="form-group")
      label(for="thumbnail") Thumbnail
      input(
        type="file"
        class="form-control"
        id="thumbnail"
        name="thumbnail"
        accept="image/*"
      )
      img(
        id="thumbnail-preview"
        src=currentThumbnail
        alt="Selected product thumbnail preview"
        style=`display: ${currentThumbnail ? "block" : "none"}; max-width: 240px; max-height: 240px; margin-top: 10px;`
      )
    div(class="form-group")
      label(for="position") Position
      input(
        type="number"
        class="form-control"
        id="position"
        name="position"
        placeholder="Auto increment"
        value=formData.position
        min="1"
      )
    div(class="form-group form-check form-check-inline")
      input(
        type="radio"
        class="form-check-input"
        id="statusActive"
        name="status"
        value="active"
        checked=formData.status !== 'inactive'
      )
      label(for="statusActive" class="form-check-label") Active
    div(class="form-group form-check form-check-inline")
      input(
        type="radio"
        class="form-check-input"
        id="statusInActive"
        name="status"
        value="inactive"
        checked=formData.status === 'inactive'
      )
      label(for="statusInActive" class="form-check-label") Inactive
    div(class="form-group")
      button(
        type="submit"
        class="btn btn-primary"
      ) #{submitText}

  script(src="https://cdn.jsdelivr.net/npm/tinymce@7/tinymce.min.js")
  script(src="/admin/js/product.js")

