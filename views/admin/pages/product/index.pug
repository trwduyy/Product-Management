extends ../../layouts/default.pug
include ../../mixins/filter-status.pug
include ../../mixins/search.pug
include ../../mixins/pagination.pug
include ../../mixins/form-change-multi.pug


block main
  h1 Product Management

  .card.mb-3
    .card-header Filter by Search
    .card-body
      .row
        .col-6
          +filter-status(filterStatus)
        .col-6 
          +search()

  .card.mb-3
    .card-header Sort Products
    .card-body
      .row
        .col-4
          select(
            class="form-control"
            id="sort-product"
          )
            option(value="position-desc" selected=(sortKey === "position" && sortValue === "desc")) Position: Descending
            option(value="position-asc" selected=(sortKey === "position" && sortValue === "asc")) Position: Ascending
            option(value="price-desc" selected=(sortKey === "price" && sortValue === "desc")) Price: Descending
            option(value="price-asc" selected=(sortKey === "price" && sortValue === "asc")) Price: Ascending
            option(value="title-desc" selected=(sortKey === "title" && sortValue === "desc")) Title: Z to A
            option(value="title-asc" selected=(sortKey === "title" && sortValue === "asc")) Title: A to Z
      

  .card.mb-3
    .card-header Product List
    .card-body
      .row
        .col-8
          +form-change-multi(`${prefixAdmin}/product/change-multi?_method=PATCH`)
        .col-4
          a(
            href=`${prefixAdmin}/product/create`
            class="btn btn-outline-success"
          ) + Add New

      table(
        class="table table-hover table-sm"
        checkbox-multi
      )
        thead
          tr
            th
              input(type="checkbox" name="checkall")
            th No.
            th Image
            th Title
            th Price
            th Position
            th Status
            th Action


        tbody
          each item, index in products
            tr 
              td
                input(
                  type="checkbox"
                  name="id"
                  value=item.id
                )
              td #{pagination.limitItems * (pagination.currentPage - 1) + (index + 1)}
              td
                img(
                  src=item.thumbnail 
                  alt=item.title
                  width="100px"
                  height="auto"
                )
              td #{item.title}
              td #{item.price}$
              td
                input(
                  type="number"
                  value=item.position
                  style="width: 60px"
                  min="1"
                  name="position"
                )
              td
                if item.status === 'active'
                  a(
                    href="javascript:;" 
                    class="badge badge-success"
                    button-change-status
                    data-status=item.status
                    data-id=item.id
                  ) Active  
                else
                  a(
                    href="javascript:;" 
                    class="badge badge-danger"
                    button-change-status
                    data-status=item.status
                    data-id=item.id
                  ) Inactive
              td
                a(
                  href=`${prefixAdmin}/product/detail/${item.id}`
                  class="btn btn-info btn-sm"
                ) View
                a(
                  href=`${prefixAdmin}/product/edit/${item.id}`
                  class="btn btn-warning btn-sm"
                ) Modify
                button(
                  class="btn btn-danger btn-sm ml-1"
                  button-delete
                  data-id=item.id
                ) Remove 

  +pagination(pagination)

  form(
    action=""
    method="POST"
    id="form-change-status"
    data-path=`${prefixAdmin}/product/change-status`
  )

  form(
    action=""
    method="POST"
    id="form-delete-item"
    data-path=`${prefixAdmin}/product/delete`
  )

  script(src="/admin/js/product.js")
