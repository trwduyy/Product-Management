extends ../../layouts/default.pug

block main
  .container.my-3
    .row
      .col-md-6
        img(
          src=product.thumbnail
          alt=product.title
          class="img-fluid"
        )
      .col-md-6
        h1 #{product.title}
        .inner-description!= product.description
        .inner-price-new #{product.newPrice}$
        .inner-price-old #{product.price}$
        p Stock: #{product.stock}
